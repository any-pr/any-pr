<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ProcessSH.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="20" Spacing="10" HorizontalAlignment="Center">

        <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="ProcessSH"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="DescriptionText"
                   FontSize="12"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <HyperlinkButton x:Name="RepoLink"
                         NavigateUri="https://github.com/CaoHaoran-Dev/ProcessSH"
                         HorizontalAlignment="Center" />

        <TextBlock x:Name="CopyrightText"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

    </StackPanel>
</Page>